<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40' dir='rtl'><head><meta charset='utf-8'><style>table{border-collapse:collapse;width:100%;} th,td{border:1px solid black;padding:5px;text-align:right;} th{background:#2c3e50;color:white;}</style></head><body><h2 style='text-align:center'>تقرير جرد المخزن - فايد ريزورت</h2>
            <table style="width:100%; border-collapse: collapse; text-align:right;">
                <thead>
                    <tr style="background:var(--primary); color:white;">
                        <th style="padding:12px; border:1px solid #ddd;">التاريخ</th>
                        <th style="padding:12px; border:1px solid #ddd;">الصنف</th>
                        <th style="padding:12px; border:1px solid #ddd;">الوحدة</th>
                        <th style="padding:12px; border:1px solid #ddd; width:100px;">الكمية</th>
                        <th style="padding:12px; border:1px solid #ddd; width:100px;">السعر</th>
                        <th style="padding:12px; border:1px solid #ddd;">الإجمالي</th>
                        <th style="padding:12px; border:1px solid #ddd;" class="no-print">حذف</th>
                    </tr>
                </thead>
                <tbody>
            <tr>
                <td style="padding:10px; border:1px solid #eee;">٢٨‏/٤‏/٢٠٢٦</td>
                <td style="padding:10px; border:1px solid #eee;">لحمه</td>
                <td style="padding:10px; border:1px solid #eee;">كيلو</td>
                <td style="padding:10px; border:1px solid #eee;">
                    <input type="number" value="13" style="width:70px; padding:5px; border:1px solid #ccc; text-align:center;" oninput="updateInventoryLive(0, 'qty', this.value)">
                </td>
                <td style="padding:10px; border:1px solid #eee;">
                    <input type="number" value="110" style="width:70px; padding:5px; border:1px solid #ccc; text-align:center;" oninput="updateInventoryLive(0, 'price', this.value)">
                </td>
                <td id="total-inv-0" style="padding:10px; border:1px solid #eee; font-weight:bold;">
                    1,430 ج
                </td>
                <td style="padding:10px; border:1px solid #eee; text-align:center;" class="no-print">
                    <button onclick="deleteInvItem(0)" style="background:none; border:none; cursor:pointer;">🗑️</button>
                </td>
            </tr>
            <tr>
                <td style="padding:10px; border:1px solid #eee;">٢٨‏/٤‏/٢٠٢٦</td>
                <td style="padding:10px; border:1px solid #eee;">فراخ </td>
                <td style="padding:10px; border:1px solid #eee;">عدد</td>
                <td style="padding:10px; border:1px solid #eee;">
                    <input type="number" value="29" style="width:70px; padding:5px; border:1px solid #ccc; text-align:center;" oninput="updateInventoryLive(1, 'qty', this.value)">
                </td>
                <td style="padding:10px; border:1px solid #eee;">
                    <input type="number" value="82" style="width:70px; padding:5px; border:1px solid #ccc; text-align:center;" oninput="updateInventoryLive(1, 'price', this.value)">
                </td>
                <td id="total-inv-1" style="padding:10px; border:1px solid #eee; font-weight:bold;">
                    2,378 ج
                </td>
                <td style="padding:10px; border:1px solid #eee; text-align:center;" class="no-print">
                    <button onclick="deleteInvItem(1)" style="background:none; border:none; cursor:pointer;">🗑️</button>
                </td>
            </tr>
            <tr>
                <td style="padding:10px; border:1px solid #eee;">٢٨‏/٤‏/٢٠٢٦</td>
                <td style="padding:10px; border:1px solid #eee;">بطاطس</td>
                <td style="padding:10px; border:1px solid #eee;">كيلو</td>
                <td style="padding:10px; border:1px solid #eee;">
                    <input type="number" value="10" style="width:70px; padding:5px; border:1px solid #ccc; text-align:center;" oninput="updateInventoryLive(2, 'qty', this.value)">
                </td>
                <td style="padding:10px; border:1px solid #eee;">
                    <input type="number" value="16" style="width:70px; padding:5px; border:1px solid #ccc; text-align:center;" oninput="updateInventoryLive(2, 'price', this.value)">
                </td>
                <td id="total-inv-2" style="padding:10px; border:1px solid #eee; font-weight:bold;">
                    160 ج
                </td>
                <td style="padding:10px; border:1px solid #eee; text-align:center;" class="no-print">
                    <button onclick="deleteInvItem(2)" style="background:none; border:none; cursor:pointer;">🗑️</button>
                </td>
            </tr>
            <tr>
                <td style="padding:10px; border:1px solid #eee;">٢٨‏/٤‏/٢٠٢٦</td>
                <td style="padding:10px; border:1px solid #eee;">عيش</td>
                <td style="padding:10px; border:1px solid #eee;">عدد</td>
                <td style="padding:10px; border:1px solid #eee;">
                    <input type="number" value="98" style="width:70px; padding:5px; border:1px solid #ccc; text-align:center;" oninput="updateInventoryLive(3, 'qty', this.value)">
                </td>
                <td style="padding:10px; border:1px solid #eee;">
                    <input type="number" value="1" style="width:70px; padding:5px; border:1px solid #ccc; text-align:center;" oninput="updateInventoryLive(3, 'price', this.value)">
                </td>
                <td id="total-inv-3" style="padding:10px; border:1px solid #eee; font-weight:bold;">
                    98 ج
                </td>
                <td style="padding:10px; border:1px solid #eee; text-align:center;" class="no-print">
                    <button onclick="deleteInvItem(3)" style="background:none; border:none; cursor:pointer;">🗑️</button>
                </td>
            </tr>
                </tbody>
                <tfoot>
                    <tr style="background:#f9f9f9; font-weight:bold;">
                        <td colspan="5" style="padding:12px; text-align:left;">إجمالي قيمة المخزن:</td>
                        <td id="grandTotalInv" colspan="2" style="padding:12px; color:var(--danger);">4,066 ج.م</td>
                    </tr>
                </tfoot>
            </table>
        </body></html>