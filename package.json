{
  "name": "fayed-resort",
  "private": true,
  "version": "1.0.0",
  "description": "نظام إدارة فايد ريزورت",
  "author": "Fayed Resort",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop": "vite build && electron .",
    "dist": "vite build && electron-builder --win --ia32 --dir",
    "shortcut": "node desktop/create-shortcut.cjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^22.3.27",
    "electron-builder": "^24.13.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.fayed.resort",
    "productName": "FayedResort",
    "copyright": "Fayed Resort",
    "asar": false,
    "asarUnpack": [
      "node_modules/sql.js/**/*"
    ],
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "server/**/*",
      "src/data/**/*",
      "src/utils/stock.js",
      "src/utils/numbers.js",
      "icon/fayed-resort.ico",
      "node_modules/sql.js/**/*"
    ],
    "extraResources": [
      {
        "from": "database",
        "to": "database-seed",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "icon/fayed-resort.ico",
        "to": "icon.ico"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "icon/fayed-resort.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "ia32"
          ]
        }
      ]
    },
    "electronVersion": "22.3.27"
  }
}
